# Скопируйте в .env, если нужно изменить значения по умолчанию. Файл .env в git не попадает.

# Модель Qwen в Ollama. Для слабых машин: qwen2.5:3b-instruct
OLLAMA_MODEL=qwen2.5:7b-instruct

# Сколько секунд ждать ответа модели (на CPU один вызов занимает 10-60 с).
OLLAMA_TIMEOUT_S=300

# Ollama на хосте вместо контейнера (используется с docker-compose.host-ollama.yml).
# OLLAMA_HOST=http://host.docker.internal:11434
